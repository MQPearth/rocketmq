<component name="ProjectRunConfigurationManager">
    <configuration default="false" name="ProxyStartup" type="Application" factoryName="Application"
                   nameIsGenerated="true">
        <envs>
            <env name="ROCKETMQ_HOME" value="$PROJECT_DIR$/"/>
        </envs>
        <option name="MAIN_CLASS_NAME" value="org.apache.rocketmq.proxy.ProxyStartup"/>
        <module name="rocketmq-proxy"/>
        <option name="VM_PARAMETERS" value="-Dcom.rocketmq.proxy.configPath=$PROJECT_DIR$/conf/rmq-proxy.json"/>
        <extension name="coverage">
            <pattern>
                <option name="PATTERN" value="org.apache.rocketmq.proxy.*"/>
                <option name="ENABLED" value="true"/>
            </pattern>
        </extension>
        <method v="2">
            <option name="Make" enabled="true"/>
        </method>
    </configuration>
</component>